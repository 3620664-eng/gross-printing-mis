# Required for the secure hosted app
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_SITE_URL=https://gross-printing.vercel.app
# Server only. Never add NEXT_PUBLIC_ to this key.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
# Legacy alternative supported by the app:
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Permanent protected owner account used by the server-side Admin API.
GROSS_PRINTING_OWNER_EMAIL=jobs@grossprinting.com

# Recommended production settings
NEXT_PUBLIC_REQUIRE_APPROVED_PROFILE=true
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false
NEXT_PUBLIC_DEMO_MODE=false

# Local demo only (do not use for the real hosted shop)
# NEXT_PUBLIC_DEMO_MODE=true

# Gross Printing Email Center — Rackspace Email, server only. Never prefix with NEXT_PUBLIC_.
GROSS_PRINTING_MAILBOX=jobs@grossprinting.com
GROSS_PRINTING_MAILBOX_PASSWORD=YOUR_MAILBOX_PASSWORD
GROSS_PRINTING_IMAP_HOST=secure.emailsrvr.com
GROSS_PRINTING_IMAP_PORT=993
GROSS_PRINTING_SMTP_HOST=secure.emailsrvr.com
GROSS_PRINTING_SMTP_PORT=465

# OpenAI AI intake and artwork assistant — server only; never prefix these with NEXT_PUBLIC_
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# Optional model routing. These defaults can be changed later without rebuilding the MIS.
OPENAI_BASIC_MODEL=gpt-5.6-luna
OPENAI_ADVANCED_MODEL=gpt-5.6-terra

